# ==============================================================
# CONTROLE DE GASTOS — VARIÁVEIS DE AMBIENTE (exemplo)
# ==============================================================
#
# Copie este arquivo para '.env' e ajuste os valores:
#
#   cp .env.example .env
#
# Os valores abaixo são apenas exemplos de desenvolvimento.

# --------------------------------------------------------------
# POSTGRESQL (banco de dados da aplicação)
# --------------------------------------------------------------
POSTGRES_DB=controle_gastos
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --------------------------------------------------------------
# BACKEND (Node.js)
# --------------------------------------------------------------
SESSION_SECRET=troque-por-um-segredo-forte
DEMO_EMAIL=aluno@email.com
DEMO_PASSWORD=123456

# --------------------------------------------------------------
# PGADMIN (interface de administração do banco)
# --------------------------------------------------------------
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=admin

# --------------------------------------------------------------
# JASPERREPORTS SERVER (relatórios)
# --------------------------------------------------------------
# Banco de repositório dedicado ao Jasper, criado no 1º boot
# do Postgres pelo script ./init-jasper.sh.
JASPER_DB_USER=jasper
JASPER_DB_PASSWORD=jasperpass
JASPER_DB_NAME=jasperserver
