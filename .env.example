# ==========================================================
# Controle de Gastos — variáveis de ambiente
#
# 1. Copie este arquivo:   cp .env.example .env
# 2. Troque TODOS os valores "troque-..." por senhas fortes.
# 3. Nunca faça commit do .env (ele já está no .gitignore).
# ==========================================================

# --- PostgreSQL (banco da aplicação) ---
POSTGRES_DB=controle_gastos
POSTGRES_USER=app_user
POSTGRES_PASSWORD=troque-esta-senha

# --- Sessão ---
# Segredo usado para assinar o cookie de sessão. O backend não inicia sem ele.
# Gere um valor aleatório com:  openssl rand -hex 32
SESSION_SECRET=troque-por-um-valor-aleatorio

# --- Login de demonstração ---
DEMO_EMAIL=aluno@email.com
DEMO_PASSWORD=troque-esta-senha

# --- pgAdmin (acessível em /admin/) ---
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=troque-esta-senha

# --- JasperReports Server (opcional; veja docs/JASPER.md) ---
# Se omitidas, o docker-compose usa os valores padrão (jasper / jasperpass).
# Defina valores próprios para qualquer uso além de testes locais.
JASPER_DB_NAME=jasperserver
JASPER_DB_USER=jasper
JASPER_DB_PASSWORD=troque-esta-senha
