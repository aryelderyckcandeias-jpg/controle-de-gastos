<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="relatorio_gastos_cliente"
              pageWidth="595"
              pageHeight="842"
              columnWidth="535"
              leftMargin="30"
              rightMargin="30"
              topMargin="30"
              bottomMargin="30">

    <!-- ==================================================
         PARÂMETROS (recebidos via REST pelo backend Node)
    =================================================== -->

    <parameter name="usuario_id" class="java.lang.Integer"/>
    <parameter name="cliente_nome" class="java.lang.String"/>

    <!-- ==================================================
         CONSULTA — gastos do cliente selecionado
    =================================================== -->

    <queryString>
        <![CDATA[SELECT g.data AS data,
                        COALESCE(c.nome, 'Sem categoria') AS categoria,
                        g.descricao AS descricao,
                        g.valor AS valor
                 FROM gastos g
                 LEFT JOIN categorias c ON c.id = g.categoria_id
                 WHERE g.usuario_id = $P{usuario_id}
                 ORDER BY g.data DESC]]>
    </queryString>

    <field name="data" class="java.sql.Date"/>
    <field name="categoria" class="java.lang.String"/>
    <field name="descricao" class="java.lang.String"/>
    <field name="valor" class="java.math.BigDecimal"/>

    <variable name="total_valor" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{valor}]]></variableExpression>
        <initialValueExpression><![CDATA[new java.math.BigDecimal(0)]]></initialValueExpression>
    </variable>

    <!-- ==================================================
         CABEÇALHO DO RELATÓRIO
    =================================================== -->

    <title>
        <band height="70">
            <staticText>
                <reportElement x="0" y="0" width="535" height="30"/>
                <textElement>
                    <font size="18" isBold="true"/>
                </textElement>
                <text><![CDATA[Relatório de Gastos]]></text>
            </staticText>

            <textField>
                <reportElement x="0" y="32" width="535" height="20"/>
                <textElement>
                    <font size="12"/>
                </textElement>
                <textFieldExpression><![CDATA["Cliente: " + $P{cliente_nome}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="0" y="52" width="535" height="15"/>
                <textElement>
                    <font size="9" isItalic="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Gerado em: " + new java.text.SimpleDateFormat("dd/MM/yyyy HH:mm").format(new java.util.Date())]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <!-- ==================================================
         CABEÇALHO DA TABELA
    =================================================== -->

    <columnHeader>
        <band height="20">
            <staticText>
                <reportElement x="0" y="0" width="80" height="20"/>
                <textElement>
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Data]]></text>
            </staticText>

            <staticText>
                <reportElement x="80" y="0" width="140" height="20"/>
                <textElement>
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Categoria]]></text>
            </staticText>

            <staticText>
                <reportElement x="220" y="0" width="215" height="20"/>
                <textElement>
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Descrição]]></text>
            </staticText>

            <staticText>
                <reportElement x="435" y="0" width="100" height="20"/>
                <textElement textAlignment="Right">
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Valor]]></text>
            </staticText>
        </band>
    </columnHeader>

    <!-- ==================================================
         LINHAS — um gasto por linha
    =================================================== -->

    <detail>
        <band height="18">
            <textField pattern="dd/MM/yyyy">
                <reportElement x="0" y="0" width="80" height="18"/>
                <textFieldExpression><![CDATA[$F{data}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="80" y="0" width="140" height="18"/>
                <textFieldExpression><![CDATA[$F{categoria}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="220" y="0" width="215" height="18"/>
                <textFieldExpression><![CDATA[$F{descricao}]]></textFieldExpression>
            </textField>

            <textField pattern="R$ #,##0.00">
                <reportElement x="435" y="0" width="100" height="18"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA[$F{valor}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <!-- ==================================================
         RODAPÉ DE PÁGINA — número da página
    =================================================== -->

    <pageFooter>
        <band height="20">
            <textField evaluationTime="Report">
                <reportElement x="435" y="0" width="100" height="20"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA["Página " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <!-- ==================================================
         RESUMO FINAL — total gasto pelo cliente
    =================================================== -->

    <summary>
        <band height="30">
            <staticText>
                <reportElement x="220" y="5" width="215" height="20"/>
                <textElement textAlignment="Right">
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Total:]]></text>
            </staticText>

            <textField pattern="R$ #,##0.00">
                <reportElement x="435" y="5" width="100" height="20"/>
                <textElement textAlignment="Right">
                    <font isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$V{total_valor}]]></textFieldExpression>
            </textField>
        </band>
    </summary>

</jasperReport>
